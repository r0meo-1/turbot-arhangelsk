user turbot;
worker_processes 1;
pid __CLOSED_HTTPS_ROOT__/nginx.pid;
error_log __CLOSED_HTTPS_ROOT__/nginx-error.log warn;
events { worker_connections 64; }
http {
 upstream closed_backend { server unix:__CLOSED_HTTPS_ROOT__/app.sock; }
 access_log off;
 server_tokens off;
 client_max_body_size 16k;
 client_body_buffer_size 16k;
 client_body_timeout 5s;
 client_body_temp_path __CLOSED_HTTPS_ROOT__/client_body;
 proxy_temp_path __CLOSED_HTTPS_ROOT__/proxy_temp;
 keepalive_timeout 5s;
 server {
  listen unix:__CLOSED_HTTPS_ROOT__/tls.sock ssl;
  server_name bot.r0meo1.ru;
  ssl_certificate /etc/letsencrypt/live/bot.r0meo1.ru/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/bot.r0meo1.ru/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  if ($host != bot.r0meo1.ru) { return 421; }
  location = /closed-webhook {
   limit_except POST { deny all; }
   proxy_pass http://closed_backend;
   proxy_set_header Host bot.r0meo1.ru;
   proxy_set_header X-Forwarded-Proto https;
   proxy_connect_timeout 3s;
   proxy_read_timeout 65s;
  }
  location = /closed-health {
   limit_except GET { deny all; }
   proxy_pass http://closed_backend;
   proxy_set_header Host bot.r0meo1.ru;
  }
  location / { return 404; }
 }
}

