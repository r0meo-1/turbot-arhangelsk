[Unit]
Description=Watchdog for %i — restart it when it stops answering Telegram
After=network.target

[Service]
Type=oneshot
# Runs as root on purpose: the whole job is `systemctl restart`.
# Invoked through bash rather than directly, so a missing +x bit after a
# `git pull` cannot turn the watchdog itself into the thing that is down.
ExecStart=/bin/bash /opt/turbot/deploy/watchdog.sh %i
