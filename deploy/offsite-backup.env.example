# Copy to /etc/turbot/offsite-backup.env, edit on the production VPS,
# then chown root:root and chmod 600. Never commit real credentials.
#
# Keep false until storage geography/compliance, access policy and the
# encryption recipient have been reviewed.
OFFSITE_BACKUP_ENABLED=false

# Approved S3-compatible endpoint/region/bucket.
OFFSITE_S3_ENDPOINT_URL=https://s3.example.invalid
OFFSITE_S3_REGION=ru-approved-region
OFFSITE_S3_BUCKET=turbot-backups
OFFSITE_S3_PREFIX=turbot

# age X25519 PUBLIC recipient only. Keep the corresponding private identity
# outside the production VPS/failure domain.
OFFSITE_AGE_RECIPIENT=age1replace_with_public_recipient

# Upload principal should be narrowly scoped to the backup bucket/prefix.
# Prefer PutObject + ListBucket only; the VPS does not need decrypt keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Freshness guard for the already-verified local SQLite backup copies.
MAX_BACKUP_AGE_SECONDS=93600
