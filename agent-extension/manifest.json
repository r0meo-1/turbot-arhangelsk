{
  "manifest_version": 3,
  "name": "TurBot Agent Desk",
  "version": "0.3.0",
  "description": "Пульт турагента: лиды, Today-очередь, история подборов/реакций, follow-up, CSV и рабочие ссылки.",
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "contextMenus"
  ],
  "host_permissions": [
    "https://bot.r0meo1.ru/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Открыть TurBot Agent Desk"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
