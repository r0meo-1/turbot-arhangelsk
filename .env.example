# Telegram Bot API token issued by @BotFather (required)
BOT_TOKEN=

# Public profile (shown in Telegram search / «О боте»). Optional overrides.
# BOT_DISPLAY_NAME=АПРЕЛЬ тур · Подбор туров
# BOT_SHORT_DESCRIPTION=Туры из Архангельска · заявка за 1–2 минуты · перезвоним
# BOT_DESCRIPTION=Официальный бот турагентства «АПРЕЛЬ тур»...

# Telegram chat_id of the admin who receives leads and runs admin commands (required).
# How to get it: write /start to @userinfobot (or your bot), copy your numeric id.
ADMIN_ID=

# Optional: extra Telegram chat IDs that also receive every new lead (comma-separated).
# If empty, leads go only to ADMIN_ID. Example: "123456789,987654321"
# LEAD_NOTIFY_IDS=

# AI mode: "groq" (default) or "template" (no external AI, works in Russia without proxies)
AI_MODE=groq

# Groq API key for AI-generated tour blurbs (optional; falls back to template if empty)
GROQ_API_KEY=

# Groq model for AI generation (optional; defaults to llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# SQLite database path for state persistence (optional; defaults to bot_state.sqlite)
DATABASE_PATH=bot_state.sqlite

# Legacy JSON state file — auto-migrated to SQLite on first start (optional)
# STATE_FILE=bot_state.json

# Port the Flask web server listens on (optional; defaults to 5000)
PORT=5000

# Secret token for Telegram webhook requests (optional; if set, Telegram sends it
# in the X-Telegram-Bot-Api-Secret-Token header and the bot rejects requests
# without a valid token). Generate a long random string.
TELEGRAM_SECRET_TOKEN=

# Hours of inactivity after which an unfinished dialog is cancelled
# (optional; default 6, set to 0 to disable the cleanup worker).
DIALOG_TIMEOUT_HOURS=6

# Hours of inactivity before sending a one-time follow-up reminder
# to users with incomplete dialogs (0 = disable follow-up).
FOLLOWUP_DELAY_HOURS=3

# Send critical error alerts to the admin via Telegram (true/false).
ADMIN_ERROR_ALERTS=true
# Minimum seconds between the same error alert (anti-spam).
ERROR_ALERT_COOLDOWN=300

# MoiDokumenti-Turism (MDT) CRM integration (optional)
# Set MDT_ENABLED=true to send completed leads to your MDT CRM.
MDT_ENABLED=false
MDT_ACCOUNT=your-subdomain              # e.g. "apreltur" for https://apreltur.moidokumenti.ru
MDT_API_KEY=
MDT_SOURCE=Telegram Bot
# MDT_BASE_URL=                         # optional override, e.g. https://custom.server.ru

# MDT operation mode: "lead" (default), "preorder", or "both"
MDT_MODE=lead

# MDT manager push notifications on new requests
MDT_NOTIFY_MANAGERS=false
# Comma-separated list of MDT manager IDs who receive push/reminder
MDT_MANAGER_IDS=

# MDT reminder (task) created for managers after a preorder is created
MDT_REMINDER_ENABLED=true
MDT_REMINDER_DAYS=1
MDT_REMINDER_TEXT=Позвонить по заявке с Telegram-бота

# --- Хранение персональных данных (152-ФЗ) ---------------------------------
# ВАЖНО: персональные данные граждан РФ (имя, телефон) должны собираться и
# храниться в базе данных, физически расположенной на территории РФ
# (ст. 18 ч. 5 152-ФЗ). НЕ размещайте эту БД на зарубежном хостинге (Render.com
# и т.п.). Используйте российский провайдер: Yandex Cloud, VK Cloud, Selectel,
# Timeweb, Reg.ru и др. Оператор (ИП) обязан подать уведомление об обработке
# ПДн в Роскомнадзор.

# URL опубликованной Политики конфиденциальности / текста согласия (показывается
# пользователю перед сбором данных). Оставьте пустым, чтобы бот показывал
# согласие без ссылки.
PRIVACY_POLICY_URL=

# Наименование оператора персональных данных (показывается в тексте согласия).
DATA_OPERATOR_NAME=ИП Замятина Мария Андреевна (ТА «АПРЕЛЬ тур», ОГРНИП 290211659807)

# Срок хранения ПДн клиента в днях; по истечении данные удаляются автоматически
# (минимизация данных, ст. 5 152-ФЗ). 0 — отключить автоудаление (не рекомендуется).
DATA_RETENTION_DAYS=180

# --- VK.com group bot (optional) ------------------------------------------
# Если вы хотите запустить бота в группе ВКонтакте (отдельный процесс),
# создайте группу VK, включите Callback API и заполните эти переменные.
# Бот запускается отдельным процессом: gunicorn vk_bot:app (см. deploy/vk-turbot.service)

# Токен доступа группы VK (Настройки → API → Ключи доступа)
VK_ACCESS_TOKEN=

# ID группы VK (положительное число, из настроек Callback API)
VK_GROUP_ID=0

# Строка подтверждения Callback API (из настроек группы VK)
VK_CONFIRMATION=

# Версия VK API (не меняйте, если не уверены)
VK_API_VERSION=5.199

# Секретный ключ Callback API (опционально, для проверки подлинности запросов)
# VK_SECRET_KEY=

# Порт для VK-бота (отличается от Telegram-бота, если оба на одной VM)
VK_PORT=5100

# Отдельный путь к БД для VK-бота (чтобы не смешивать с Telegram)
# VK_DATABASE_PATH=vk_bot_state.sqlite
