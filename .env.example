# Telegram Bot API token issued by @BotFather (required)
BOT_TOKEN=

# Telegram chat_id of the admin who receives leads and runs admin commands (required)
ADMIN_ID=

# U-ON CRM API key used to create leads (optional; lead push is skipped if empty)
UON_API_KEY=

# Travelata affiliate / partner ID appended to generated search links (optional)
TRAVELATA_PARTNER_ID=

# Groq API key for AI-generated tour blurbs (optional; falls back to a static message if empty)
GROQ_API_KEY=

# Port the Flask web server listens on (optional; defaults to 5000)
PORT=5000
