# Telegram Bot API token issued by @BotFather (required)
BOT_TOKEN=

# Public profile (shown in Telegram search / «О боте»). Optional overrides.
# BOT_DISPLAY_NAME=АПРЕЛЬ тур · Подбор туров
# BOT_SHORT_DESCRIPTION=Туры из Архангельска · заявка за 1–2 минуты · перезвоним
# BOT_DESCRIPTION=Официальный бот турагентства «АПРЕЛЬ тур»...

# Telegram chat_id of the admin who receives leads and runs admin commands (required).
# How to get it: write /start to @userinfobot (or your bot), copy your numeric id.
ADMIN_ID=

# Optional: extra Telegram chat IDs that also receive every new lead (comma-separated).
# If empty, leads go only to ADMIN_ID. Example: "123456789,987654321"
# LEAD_NOTIFY_IDS=

# AI mode: "groq" (default) or "template" (no external AI, works in Russia without proxies)
AI_MODE=groq

# Groq API key for AI-generated tour blurbs (optional; falls back to template if empty)
GROQ_API_KEY=

# Groq model for AI generation (optional; defaults to llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# SQLite database path for state persistence (optional; defaults to bot_state.sqlite)
DATABASE_PATH=bot_state.sqlite

# Legacy JSON state file — auto-migrated to SQLite on first start (optional)
# STATE_FILE=bot_state.json

# Port the Flask web server listens on (optional; defaults to 5000)
PORT=5000

# Secret token for Telegram webhook requests (optional; if set, Telegram sends it
# in the X-Telegram-Bot-Api-Secret-Token header and the bot rejects requests
# without a valid token). Generate a long random string.
TELEGRAM_SECRET_TOKEN=

# Hours of inactivity after which an unfinished dialog is cancelled
# (optional; default 6, set to 0 to disable the cleanup worker).
DIALOG_TIMEOUT_HOURS=6

# Hours of inactivity before sending a one-time follow-up reminder
# to users with incomplete dialogs (0 = disable follow-up).
FOLLOWUP_DELAY_HOURS=3

# Send critical error alerts to the admin via Telegram (true/false).
ADMIN_ERROR_ALERTS=true
# Minimum seconds between the same error alert (anti-spam).
ERROR_ALERT_COOLDOWN=300

# MoiDokumenti-Turism (MDT) CRM integration (optional)
# Set MDT_ENABLED=true to send completed leads to your MDT CRM.
MDT_ENABLED=false
MDT_ACCOUNT="your-subdomain"            # e.g. apreltur for https://apreltur.moidokumenti.ru
MDT_API_KEY=
MDT_SOURCE="Telegram Bot"
# MDT_BASE_URL=                         # optional override, e.g. https://custom.server.ru

# MDT operation mode: "lead" (default), "preorder", or "both"
MDT_MODE=lead

# MDT manager push notifications on new requests
MDT_NOTIFY_MANAGERS=false
# Comma-separated list of MDT manager IDs who receive push/reminder
MDT_MANAGER_IDS=

# MDT reminder (task) created for managers after a preorder is created
MDT_REMINDER_ENABLED=true
MDT_REMINDER_DAYS=1
MDT_REMINDER_TEXT="Позвонить по заявке с Telegram-бота"

# Consent UX: "soft" (default) — short notice + «Начать», contact via TG/phone/VK.
# "strict" — classic «Согласен / Отказаться» before questions.
CONSENT_MODE=soft

# --- Хранение персональных данных (152-ФЗ) ---------------------------------
# ВАЖНО: персональные данные граждан РФ (имя, телефон) должны собираться и
# храниться в базе данных, физически расположенной на территории РФ
# (ст. 18 ч. 5 152-ФЗ). НЕ размещайте эту БД на зарубежном хостинге (Render.com
# и т.п.). Используйте российский провайдер: Yandex Cloud, VK Cloud, Selectel,
# Timeweb, Reg.ru и др. Оператор (ИП) обязан подать уведомление об обработке
# ПДн в Роскомнадзор.

# URL опубликованной Политики конфиденциальности / текста согласия (показывается
# пользователю перед сбором данных). Оставьте пустым, чтобы бот показывал
# согласие без ссылки.
PRIVACY_POLICY_URL=

# Наименование оператора персональных данных (показывается в тексте согласия).
# Ст. 9 ч. 4 152-ФЗ требует назвать оператора в согласии, поэтому на боевом
# сервере сюда идут полные реквизиты: «ИП Фамилия И. О., ОГРНИП <15 цифр>».
# В репозитории остаётся только бренд: реквизиты конкретного предпринимателя —
# это чужие персональные данные, и публичному коду они не принадлежат.
DATA_OPERATOR_NAME="ТА «АПРЕЛЬ тур»"

# Срок хранения ПДн клиента в днях; по истечении данные удаляются автоматически
# (минимизация данных, ст. 5 152-ФЗ). 0 — отключить автоудаление (не рекомендуется).
DATA_RETENTION_DAYS=180

# --- VK.com group bot (optional) ------------------------------------------
# Если вы хотите запустить бота в группе ВКонтакте (отдельный процесс),
# создайте группу VK, включите Callback API и заполните эти переменные.
# Бот запускается отдельным процессом: gunicorn vk_bot:app (см. deploy/vk-turbot.service)

# Токен доступа группы VK (Настройки → API → Ключи доступа)
VK_ACCESS_TOKEN=

# ID группы VK (положительное число, из настроек Callback API)
VK_GROUP_ID=0

# Строка подтверждения Callback API (из настроек группы VK)
VK_CONFIRMATION=

# Версия VK API (не меняйте, если не уверены)
VK_API_VERSION=5.199

# Секретный ключ Callback API (обязателен: задайте тот же в настройках VK).
# Генерация: openssl rand -hex 32
VK_SECRET_KEY=

# Порт для VK-бота (отличается от Telegram-бота, если оба на одной VM)
VK_PORT=5100

# Отдельный путь к БД для VK-бота (чтобы не смешивать с Telegram)
# VK_DATABASE_PATH=vk_bot_state.sqlite

# ============================================================================
# Tutu.ru MCP — живые предложения по перелёту
# ============================================================================
# Публичный MCP-сервер Tutu (https://mcp.tutu.ru/mcp): поиск авиа/ж-д/автобусов
# и сборка ссылок на оплату. Авторизация не нужна, сервер stateless.
# Поиск выполняется ТОЛЬКО в фоновом потоке после сохранения заявки, поэтому
# недоступность Tutu не может помешать лиду сохраниться или дойти до админа.

# Включить интеграцию. По умолчанию ВКЛЮЧЕНА: сервис публичный, без ключей,
# и при любой ошибке бот молча откатывается на шаблонную подборку — поэтому
# требовать ручной переменной на каждом деплое незачем.
# TUTU_ENABLED=true

# Эндпоинт MCP-сервера
# TUTU_ENDPOINT=https://mcp.tutu.ru/mcp

# Таймаут запроса, секунд. Простой поиск в одну сторону укладывается в 2–3 с,
# но запрос «туда-обратно» на семью из пяти человек занял на живом сервере
# 22.8 с — с прежним значением 12 такие поиски молча отваливались, и клиент
# получал шаблонную заглушку вместо цен. Поиск идёт в фоне после сохранения
# заявки, поэтому ожидание никого не задерживает.
# TUTU_TIMEOUT=30

# Город вылета, если клиент не указал свой
# TUTU_DEFAULT_ORIGIN=Архангельск

# Сколько вариантов показывать
# TUTU_MAX_OFFERS=3

# Время жизни кэша поиска, секунд. Кэш только в памяти:
# на Render диск эфемерный, хранить его на диске бессмысленно.
# TUTU_CACHE_TTL=900

# Кому показывать результат.
# Клиент получает ориентир по ценам БЕЗ ссылки на оплату: дать клиенту
# кнопку «купить» — значит увести продажу мимо агентства.
# Менеджер получает ту же цену плюс готовые ссылки на оформление.
# TUTU_SHOW_CLIENT=true
# TUTU_SHOW_ADMIN=true

# Раздельные флаги для VK: перекрывают общие только для него.
# Telegram — витрина, где живые цены и есть смысл; VK принимает настоящие
# заявки, и агентство может не хотеть, чтобы там вообще звучали цены билетов.
# VK_TUTU_ENABLED=false
# VK_TUTU_SHOW_CLIENT=true
# VK_TUTU_SHOW_ADMIN=true

# ============================================================================
# Tourvisor — автоматический поиск пакетных туров в VK
# ============================================================================
# JWT из личного кабинета Tourvisor. Не коммитьте реальный токен в Git.
# Если токен заполнен, поиск для VK включается автоматически.
TOURVISOR_TOKEN=

# Быстрое отключение поиска без удаления токена.
# VK_TOURVISOR_ENABLED=true

# Обычно менять не требуется.
# TOURVISOR_BASE_URL=https://api.tourvisor.ru/search/api/v1
# TOURVISOR_TIMEOUT=15
# TOURVISOR_POLL_INTERVAL=3
# TOURVISOR_MAX_WAIT=15
# TOURVISOR_MAX_OFFERS=3

# ============================================================================
# Как боту приходят апдейты
# ============================================================================
# webhook (по умолчанию) — Telegram сам стучится в /webhook. Нужен входящий
#   HTTPS-доступ из сети Telegram до этого хоста.
# polling — бот сам забирает апдейты через getUpdates. Нужен только исходящий.
#
# Polling существует не для удобства: некоторые хостинги режут адреса Telegram
# в ОБЕ стороны. На таком сервере getWebhookInfo показывал «Connection timed
# out» и растущую очередь, а в логах nginx не было ни одного запроса от
# Telegram — доставка не могла состояться в принципе. Polling там работает,
# потому что соединение открывается изнутри.
# BOT_MODE=webhook

# Сколько секунд Telegram держит запрос открытым, ожидая апдейт.
# Больше значение — меньше запросов, доставка при этом не медленнее.
# POLL_TIMEOUT=25

# Через сколько секунд без единого успешного getUpdates считать бота больным.
# /health в этом случае отвечает 503, а не 200 — по этому коду сторож
# (deploy/watchdog.sh) перезапускает сервис.
#
# Дважды бот замолкал, оставаясь «живым»: systemd показывал active, /health
# отвечал ok, в логе тишина, и обнаруживал это клиент, а не мы. Один неудачный
# цикл с максимальным бэкоффом стоит ~100 секунд, поэтому запас до 180.
# POLL_STALE_AFTER=180

# ============================================================================
# Демо-режим
# ============================================================================
# Публичная витрина не должна собирать настоящие телефоны от лица реального
# ИП. В демо-режиме воронка работает целиком и цены приходят настоящие, но бот
# прямо предупреждает, что это витрина, и хранит замаскированный номер
# (+7916***4567) вместо реального.
#
# Включается сам на Render (там выставлена переменная RENDER), на своей VM —
# выключен. Переопределяется явно.
# DEMO_MODE=false

# Отдельный флаг для VK-бота: перекрывает DEMO_MODE только для него.
# Оба бота читают один .env, но используются по-разному — Telegram может быть
# витриной в портфолио, пока VK принимает настоящие заявки агентства.
# VK_DEMO_MODE=false

# Публичный адрес инстанса. Нужен, чтобы бот собрал ссылку на собственную
# страницу /privacy в тексте согласия. На Render берётся из RENDER_EXTERNAL_URL
# автоматически; на своей VM это пишет deploy/install.sh.
# PUBLIC_BASE_URL=https://bot.example.ru

# ============================================================================
# Прочее
# ============================================================================
# Выполнять MDT/AI/Tutu синхронно вместо фонового потока.
# Используется в тестах; в проде держите выключенным, иначе webhook
# будет ждать медленный ввод-вывод.
# SYNC_COMPLETION=false
